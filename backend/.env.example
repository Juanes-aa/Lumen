# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Anon key (pública en Supabase) — usada por el cliente per-request
# que aplica el JWT del usuario y respeta RLS. Obligatoria.
SUPABASE_ANON_KEY=your-anon-key
# Service role key — solo para operaciones de Auth Admin (register).
# OMNIPOTENTE: bypassea RLS. No usar para queries de datos de usuario.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM
GROQ_API_KEY=your-groq-api-key

# TMDB
TMDB_API_KEY=your-tmdb-api-key

# CORS: lista separada por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://your-lumen-domain.vercel.app

# Cookie de refresh_token.
# COOKIE_SECURE: debe ser true en producción (Render → HTTPS). El default
# del código es true. En desarrollo local con HTTP, setear false.
# COOKIE_SAMESITE: 'none' para cross-domain (Vercel ⇄ Render). Cuando
# COOKIE_SAMESITE=none, COOKIE_SECURE debe ser true obligatoriamente
# (los browsers rechazan SameSite=None; Secure=false).
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Rate limiting con Redis (opcional).
# Si hay más de 1 worker en Render, configurar REDIS_URL para que el
# rate limiting sea compartido entre procesos. Sin esto cada worker
# tiene su propio bucket y el límite efectivo es N_workers × límite.
# REDIS_URL=redis://user:password@host:6379/0

# Límites diarios de mensajes LLM por tier (0 = sin límite).
# FREE_DAILY_MESSAGE_LIMIT=50
# PRO_DAILY_MESSAGE_LIMIT=0
