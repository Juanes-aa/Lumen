# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Anon key (pública en Supabase) — usada por el cliente per-request
# que aplica el JWT del usuario y respeta RLS. Obligatoria.
SUPABASE_ANON_KEY=your-anon-key
# Service role key — solo para operaciones de Auth Admin (register).
# OMNIPOTENTE: bypassea RLS. No usar para queries de datos de usuario.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM
GROQ_API_KEY=your-groq-api-key

# TMDB
TMDB_API_KEY=your-tmdb-api-key

# CORS: lista separada por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://cinethink.vercel.app
